# OS
.DS_Store
Thumbs.db

# エディタ / IDE
.vscode/
.idea/
*.swp
*~

# Claude Code のローカル設定（個人環境依存のため共有しない）
.claude/settings.local.json

# 開発中のアプリデータ（ADR-0021 / ADR-0022）
# release では OS のアプリデータ領域を使う。ここは debug ビルド専用。
# コミットされないことの保証は .gitignore ではなく CI の判定にある。
.local/

# ローカル専用のメモ置き場（ADR-0012）
# ここに置いたものは共有されない。共有すべき論点は GitHub Issue に立てる。
# 場所の説明である README.md だけは追跡する。
docs/notes/*
!docs/notes/README.md

# 秘密情報 — 絶対にコミットしない
.env
.env.*
*.pem
*.key
secrets/

# 艦これのゲームデータ・通信ログ
# プレイヤー情報や認証情報を含みうるため、リポジトリには入れない
# （docs/spec/constraints.md C-04 / C-05）
*.har
captures/
gamedata/
screenshots/

# ビルド成果物（技術構成の決定後に必要に応じて追記する）
dist/
build/
out/
node_modules/
target/
__pycache__/
